# 운영 환경변수. 이 파일을 .env로 복사해서 값을 채운다 (.env는 git에 올리지 않는다)
#   cp .env.example .env
# 값 뒤에 주석을 붙이지 말 것 (주석은 항상 따로 한 줄)

# ===== 도메인 =====
# 백엔드 주소 (가비아 DNS에서 이 이름의 A 레코드를 EC2 탄력적 IP로 연결)
API_DOMAIN=api.example.site
# 프론트(Vercel) 주소. 나이스페이 결제 후 돌아올 페이지의 앞부분
FRONTEND_URL=https://example.site
# 백엔드를 호출할 수 있는 프론트 주소 (여러 개면 쉼표로)
CORS_ALLOWED_ORIGINS=https://example.site

# ===== DB (EC2 안의 PostgreSQL) =====
POSTGRES_DB=kiwi
POSTGRES_USER=kiwi
# openssl rand -base64 24
POSTGRES_PASSWORD=

# ===== 필수 비밀값 (한 번 정하면 바꾸지 않는다) =====
# openssl rand -base64 32
JWT_SECRET=
# openssl rand -base64 32. 바꾸면 암호화된 연락처를 읽을 수 없게 된다
APP_CRYPTO_KEY=

# ===== 나이스페이 =====
# start.nicepay.co.kr > 개발정보 > API KEY (클라이언트 키, 시크릿 키)
NICEPAY_CLIENT_ID=
NICEPAY_SECRET_KEY=
# 샌드박스 키면 그대로 두고, 운영 키로 바꿀 때 https://api.nicepay.co.kr
NICEPAY_BASE_URL=https://sandbox-api.nicepay.co.kr
# 결제창 인증 후 나이스페이가 돌아올 백엔드 주소 (https://{API_DOMAIN}/payments/nicepay/return)
NICEPAY_RETURN_URL=https://api.example.site/payments/nicepay/return

# ===== 가입 인증 메일 (운영에서는 필수. 없으면 가입이 안 된다) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true

# ===== 선택 =====
PORTONE_API_SECRET=
PORTONE_STORE_ID=
PORTONE_IDENTITY_CHANNEL_KEY=
LINER_API_KEY=
RTC_TURN_URLS=
RTC_TURN_SHARED_SECRET=
